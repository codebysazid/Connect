<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_premium_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- ==================== HEADER (Device Icon, Centered Device Name, Battery Pill) ==================== -->
    <LinearLayout
        android:id="@+id/row_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp"
        android:paddingHorizontal="4dp">

        <!-- Left: Device Icon (in a subtle bubble) -->
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_icon_bubble">
            <ImageView
                android:id="@+id/img_device_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_device_laptop_32dp"
                android:tint="@color/m3_widget_on_surface" />
        </FrameLayout>

        <!-- Center: Device Name -->
        <TextView
            android:id="@+id/txt_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:textAlignment="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Laptop"
            android:textColor="@color/m3_widget_on_surface"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Right: Battery Badge Pill -->
        <TextView
            android:id="@+id/txt_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_premium_button_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="⚡ --"
            android:textColor="@color/m3_widget_on_secondary_container"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- ==================== BUTTON 1: VIEW ==================== -->
    <LinearLayout
        android:id="@+id/btn_view_monitor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_premium_button_bg"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_icon_bubble">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_screen_share"
                android:tint="@color/m3_widget_on_secondary_container" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="View"
            android:textColor="@color/m3_widget_on_secondary_container"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- ==================== BUTTON 2: LOCK PC ==================== -->
    <LinearLayout
        android:id="@+id/btn_lock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"
        android:background="@drawable/widget_premium_button_bg"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_icon_bubble">
            <ImageView
                android:id="@+id/img_lock_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                android:tint="@color/m3_widget_on_secondary_container" />
        </FrameLayout>

        <TextView
            android:id="@+id/txt_lock_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Lock PC"
            android:textColor="@color/m3_widget_on_secondary_container"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- ==================== BUTTON 3: SHARE FILES ==================== -->
    <LinearLayout
        android:id="@+id/btn_share_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_premium_button_bg"
        android:clickable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_icon_bubble">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_baseline_send_24"
                android:tint="@color/m3_widget_on_secondary_container" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:ellipsize="none"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Share Files"
            android:textColor="@color/m3_widget_on_secondary_container"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</LinearLayout>
