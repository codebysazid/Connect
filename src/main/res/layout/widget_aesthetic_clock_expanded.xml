<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_widget_root_expanded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="10dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <!-- ==================== BACKGROUND LAYER: GIANT FADED TIME ==================== -->
        <TextClock
            android:id="@+id/txt_clock_bg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:format12Hour="hh mm"
            android:format24Hour="HH mm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:singleLine="true"
            android:textColor="#59FFFFFF"
            android:textSize="92sp"
            android:textStyle="bold" />

        <!-- ==================== SPARKLE STAR ACCENT ==================== -->
        <ImageView
            android:id="@+id/img_clock_sparkle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignBottom="@id/txt_clock_bg_time"
            android:layout_alignStart="@id/txt_clock_bg_time"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/ic_star_sparkle_glow" />

        <!-- ==================== FOREGROUND LAYER: DAY & DATE ==================== -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Day of Week (e.g. "Saturday") -->
            <TextClock
                android:id="@+id/txt_clock_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:gravity="center"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="10"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <!-- Date (e.g. "29 August 2026") -->
            <TextClock
                android:id="@+id/txt_clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:format12Hour="d MMMM yyyy"
                android:format24Hour="d MMMM yyyy"
                android:gravity="center"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:textColor="#F2F2F2"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
