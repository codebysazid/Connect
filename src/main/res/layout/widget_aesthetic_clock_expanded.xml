<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_widget_root_expanded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="6dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <!-- ==================== BACKGROUND LAYER: GIANT FADED TIME ==================== -->
        <LinearLayout
            android:id="@+id/layout_bg_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/txt_clock_hour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh"
                android:format24Hour="HH"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#59FFFFFF"
                android:textSize="72sp"
                android:textStyle="bold" />

            <View
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <TextClock
                android:id="@+id/txt_clock_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="mm"
                android:format24Hour="mm"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#59FFFFFF"
                android:textSize="72sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ==================== GLOWING SPARKLE STAR ACCENT ==================== -->
        <ImageView
            android:id="@+id/img_clock_sparkle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignBottom="@id/layout_bg_time"
            android:layout_alignStart="@id/layout_bg_time"
            android:layout_marginStart="-10dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_star_sparkle_glow" />

        <!-- ==================== FOREGROUND LAYER: DAY & DATE ==================== -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Day of Week (Single Line, Crisp Bold) -->
            <TextClock
                android:id="@+id/txt_clock_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE"
                android:format24Hour="EEEE"
                android:gravity="center"
                android:includeFontPadding="false"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="10"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- Date -->
            <TextClock
                android:id="@+id/txt_clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:format12Hour="d MMMM yyyy"
                android:format24Hour="d MMMM yyyy"
                android:gravity="center"
                android:includeFontPadding="false"
                android:shadowColor="#E6000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:singleLine="true"
                android:textColor="#F5F5F7"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
