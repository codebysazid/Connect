<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calc_widget_root_expanded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_calc_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- ==================== DISPLAY AREA ==================== -->
    <LinearLayout
        android:id="@+id/calc_display_container_expanded"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:background="@drawable/widget_calc_display_bg"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:layout_marginBottom="8dp">

        <!-- Top Header Line: Mode Tag + Expression History -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEG"
                android:textColor="@color/calc_display_expr"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_calc_expression"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="start"
                android:gravity="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/calc_display_expr"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Main Display / Current Value -->
        <TextView
            android:id="@+id/txt_calc_result"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:singleLine="true"
            android:text="0"
            android:textColor="@color/calc_display_val"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ==================== KEYPAD GRID ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical">

        <!-- ROW 1: AC, ±, %, ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/btn_calc_ac"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_calc_btn_action"
                android:gravity="center"
                android:text="AC"
                android:textColor="@color/calc_btn_action_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_pm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/widget_calc_btn_action"
                android:gravity="center"
                android:text="±"
                android:textColor="@color/calc_btn_action_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_percent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/widget_calc_btn_action"
                android:gravity="center"
                android:text="%"
                android:textColor="@color/calc_btn_action_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_div"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_calc_btn_op"
                android:gravity="center"
                android:text="÷"
                android:textColor="@color/calc_btn_op_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 2: 7, 8, 9, × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/btn_calc_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="7"
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="8"
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="9"
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_mul"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_calc_btn_op"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/calc_btn_op_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 3: 4, 5, 6, − -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/btn_calc_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_sub"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_calc_btn_op"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/calc_btn_op_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 4: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/btn_calc_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_add"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_calc_btn_op"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/calc_btn_op_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 5: 0, ., ⌫, = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_calc_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_dot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/widget_calc_btn_num"
                android:gravity="center"
                android:text="."
                android:textColor="@color/calc_btn_num_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/widget_calc_btn_action"
                android:gravity="center"
                android:text="⌫"
                android:textColor="@color/calc_btn_action_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_calc_eq"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_calc_btn_eq"
                android:gravity="center"
                android:text="="
                android:textColor="@color/calc_btn_eq_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
